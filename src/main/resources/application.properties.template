spring.application.name=nomPrenomClasseExamen
server.port=8089
### DATABASE ###
spring.datasource.url=jdbc:mysql://localhost:3306/ETAP_DB?createDatabaseIfNotExist=true
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
### JPA / HIBERNATE ###
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto= update

# JWT
# Base64-encoded signing key. Generate one, e.g.: openssl rand -base64 48
application.security.jwt.secret-key=${JWT_SECRET}
application.security.jwt.expiration=86400000

# Google OAuth2
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}

# CORS — comma-separated list of allowed frontend origins (never "*", credentials are allowed)
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:4200}

# Mailing
# Activation link base. Default hits the backend directly (GET /auth/activate-account?token=...).
# Point it at the Angular activation page in production, e.g. http://localhost:4200/activate-account
application.mailing.activation-url=${ACTIVATION_URL:http://localhost:8089/auth/activate-account}
# Password-reset link base. This is a FRONTEND page that collects the new password and calls
# POST /auth/reset-password. Angular must expose this route and read ?token=.
application.mailing.reset-password-url=${RESET_PASSWORD_URL:http://localhost:4200/reset-password}
# Sender address for outgoing mail. Leave blank to use spring.mail.username (must match it for Gmail).
application.mailing.from=${MAIL_FROM:}
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME}
# Gmail requires a 16-char App Password (account with 2FA), NOT the normal account password.
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.default-encoding=UTF-8

#Logging
logging.level.root = info
logging.pattern.console= %d{yyyy-MM-dd HH:mm:ss} -%level -%logger{60} %msg %n

# Fixer FX rates
fixer.api.key=${FIXER_API_KEY}

# Reporting currency — every monetary value that is aggregated, compared, used as an
# ML feature/target, or displayed together in DSS analytics is normalised to this.
# EUR is the default and also the pivot currency the Fixer integration stores rates against.
reporting.currency=EUR


# Open-Meteo
weather.open-meteo.forecast-url=https://api.open-meteo.com/v1/forecast
weather.open-meteo.historical-url=https://archive-api.open-meteo.com/v1/archive
weather.open-meteo.default-timezone=auto

# EIA Oil Price API (free key: https://www.eia.gov/opendata/register.php) - optional
eia.api.key=${EIA_API_KEY:}
eia.api.base-url=https://api.eia.gov/v2

# Energy price derivation (gas from EIA Henry Hub, electricity = gas × multiplier)
energy.usd-mmbtu-to-eur-mwh=3.14
energy.electricity-gas-multiplier=2.8

# ML Microservice (Python Flask)
ml.service.base-url=http://localhost:5001
ml.auto-retrain-interval-minutes=60


# Groq
groq.api-key=${GROQ_API_KEY}
groq.base-url=https://api.groq.com/openai/v1
groq.intent-model=llama-3.1-8b-instant
groq.answer-model=llama-3.3-70b-versatile
